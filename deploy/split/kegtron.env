# Kegtron API Environment Variables

KEGTRON_PROXY_ENV=production
KEGTRON_PROXY_APP_SECRET_KEY=<CHANGE TO A VALID SECRET KEY>

# API Configuration
KEGTRON_PROXY_API_HOST=0.0.0.0
KEGTRON_PROXY_API_PORT=8080
KEGTRON_PROXY_API_LOG_LEVEL=INFO
KEGTRON_PROXY_SCANNER_SERVICE_ACCOUNT_API_KEY=<CHANGE TO A VALID API KEY>

# Database Configuration
KEGTRON_PROXY_DB_BASE_DIR=/opt/kegtron-gen1-api-proxy/data

# Proxy Configuration
KEGTRON_PROXY_PROXY_SCANNER_ENABLED=false

# Scanner Configuration
KEGTRON_PROXY_SCANNER_LOG_LEVEL=INFO
KEGTRON_PROXY_SCANNER_RESTART_DELAY=10
KEGTRON_PROXY_SCANNER_BACKEND=db

# Config Directory
KEGTRON_PROXY_CONFIG_BASE_DIR=/opt/kegtron-gen1-api-proxy/config
KEGTRON_PROXY_CONFIG_PATH=kegtron.config.json

# Static Files Directory
KEGTRON_PROXY_STATIC_FILES_DIR=/opt/kegtron-gen1-api-proxy/src/static

# set initial user password
KEGTRON_PROXY_AUTH_INITIAL_USER_EMAIL=<CHANGE TO A VALID EMAIL>
KEGTRON_PROXY_AUTH_INITIAL_USER_PASSWORD=password
KEGTRON_PROXY_AUTH_INITIAL_USER_API_KEY=<CHANGE TO A VALID API KEY>